# Copy to .env.local (gitignored) and set your own server.
# Full origin only: scheme + host (+ port). No path, no trailing slash.
SERVER_ORIGIN=https://books.example.com

# Your own package id for uploading to Even Hub: ids are unique across Even
# Hub, so the default (the author's) is taken. Lowercase letters and digits,
# dot-separated, e.g. com.yourname.glassshelf.
# PACKAGE_ID=com.yourname.glassshelf

# Dev only (npm run dev): pre-fill the app's settings, handy in the simulator.
# Never used in packed builds.
# VITE_DEV_SERVER_URL=https://books.example.com
# VITE_DEV_SERVER_USER=reader
# VITE_DEV_SERVER_PASSWORD=
